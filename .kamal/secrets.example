# .kamal/secrets.example — TEMPLATE. Copy to .kamal/secrets and fill real values:
#   cp .kamal/secrets.example .kamal/secrets
# .kamal/secrets is gitignored; this .example file is the committed reference.
# Generate the random values with: openssl rand -hex 32
#
# IMPORTANT: the password inside DATABASE_URL must be the EXACT SAME string as
# POSTGRES_PASSWORD (the db is created with it; the api connects with it).

# Server IP is read by config/deploy.yml via ERB so it stays out of the committed file.
SERVER_IP=replace_with_your_hetzner_ipv4
KAMAL_REGISTRY_PASSWORD=ghp_your_github_PAT_with_write_packages
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
GEMINI_API_KEY=your_gemini_api_key
ADMIN_SECRET=replace_with_another_openssl_rand_hex_32
DATABASE_URL=postgresql://bookrag:THE_SAME_POSTGRES_PASSWORD@golden-book-rag-db:5432/bookrag
